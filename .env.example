# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyB4MRImJQdAFD9DhErmk7744hoQmNFvybA"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OHMABA_URL: Optional custom agent endpoint for ohmaba / self-hosted free chat.
# Example: http://localhost:8080/api/chat
OHMABA_URL="http://localhost:8080/api/chat"
# OHMABA_API_KEY: Optional bearer token if your endpoint requires authentication.
OHMABA_API_KEY=""

# DEFAULT_MODEL: Chọn provider mặc định. Sử dụng zsk để chạy agent demo free nội bộ.
DEFAULT_MODEL="zsk"
